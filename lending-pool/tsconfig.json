{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "lib": ["ES2022"],
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "types": ["mocha", "node"]
  },
  "include": ["./scripts", "./test", "./test-suites", "./tasks", "./helpers", "./markets"],
  "exclude": ["node_modules"],
  "files": [
    "./hardhat.config.ts",
    "./modules/tenderly/tenderly.d.ts"
  ]
}
