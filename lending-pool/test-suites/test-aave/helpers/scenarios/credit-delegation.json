{
  "title": "LendingPool: credit delegation",
  "description": "Test cases for the credit delegation related functions.",
  "stories": [
    {
      "description": "User 4 trying to borrow 1 bvBTC stable on behalf of user 0, revert expected",
      "actions": [
        {
          "name": "borrow",
          "args": {
            "reserve": "bvBTC",
            "amount": "1",
            "user": "4",
            "onBehalfOf": "0",
            "borrowRateMode": "stable"
          },
          "expected": "revert",
          "revertMessage": "59"
        }
      ]
    },
    {
      "description": "User 0 delegates borrowing of 1 bvBTC to user 4, user 4 borrows 3 bvBTC variable on behalf of user 0, revert expected",
      "actions": [
        {
          "name": "delegateBorrowAllowance",
          "args": {
            "reserve": "bvBTC",
            "amount": "1",
            "user": "0",
            "borrowRateMode": "variable",
            "toUser": "4"
          },
          "expected": "success"
        },
        {
          "name": "borrow",
          "args": {
            "reserve": "bvBTC",
            "amount": "3",
            "user": "4",
            "onBehalfOf": "0",
            "borrowRateMode": "variable"
          },
          "expected": "revert",
          "revertMessage": "59"
        }
      ]
    }
  ]
}
